<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/etCliente"
        android:hint="Nombre cliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etRut"
        android:hint="RUT cliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etVehiculo"
        android:hint="Vehículo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etPatente"
        android:hint="Patente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnUploadLogo"

        android:text="Subir Logo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ListView
        android:id="@+id/listCosts"
        android:layout_width="match_parent"
        android:layout_height="250dp"/>



    <TextView
        android:id="@+id/txtTotal"
        android:text="Total:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtIVA"
        android:text="IVA:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtFinal"
        android:text="Final:"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>



    <Button
        android:id="@+id/btnGenerate"
        android:background="@drawable/button_glow"
        android:text="Calcular y Generar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>




</LinearLayout>