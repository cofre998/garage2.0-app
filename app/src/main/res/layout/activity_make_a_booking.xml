<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background">

        <include
            android:id="@+id/toolbar"
            layout="@layout/custom_toolbar" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- PATENTE -->
        <EditText
            android:id="@+id/vehicles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Ej: AB-CD-12 o ABCD12"
            android:textColor="#000"
            android:background="@drawable/shape_button2"
            android:padding="12dp"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TIPO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Tipo de servicio"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/vehicles"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <AutoCompleteTextView
                android:id="@+id/typeOfBookingInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CHECK -->
        <CheckBox
            android:id="@+id/checkOnSite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Servicio a terreno (+ costo)"
            android:textColor="@android:color/white"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/layoutType"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- DIRECCIÓN -->
        <EditText
            android:id="@+id/inputAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Dirección"
            android:visibility="gone"
            android:background="@drawable/shape_button2"
            android:padding="12dp"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/checkOnSite"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TELÉFONO -->
        <EditText
            android:id="@+id/inputPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Teléfono"
            android:inputType="phone"
            android:background="@drawable/shape_button2"
            android:padding="12dp"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/inputAddress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- CALENDARIO -->
        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/inputPhone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- HORARIOS -->
        <Spinner
            android:id="@+id/listViewShifts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/calendarView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BOTÓN -->
        <Button
            android:id="@+id/book"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Crear Cita"
            android:background="@drawable/shape_button"
            android:textColor="#fff"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/listViewShifts"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- LIMPIAR -->
        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nuevo Booking"
            android:background="@drawable/button_pro"
            android:textColor="#fff"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/book"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>