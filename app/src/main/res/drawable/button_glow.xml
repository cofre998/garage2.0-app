<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PRESIONADO -->
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#6A5CFF"
                android:endColor="#2E8BFF"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="2dp"
                android:color="#00E5FF"/>
        </shape>
    </item>

    <!-- NORMAL -->
    <item>
        <shape>
            <gradient
                android:startColor="#2E8BFF"
                android:endColor="#6A5CFF"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</selector>